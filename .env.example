QFAE_ENVIRONMENT=development
QFAE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
QFAE_FRONTEND_URL=http://localhost:3000

UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Optional one-year, read-only token generated from Upstox Developer Apps.
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/auth/upstox/callback

QFAE_REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# Keep only the recent live working set in Redis. PostgreSQL remains the durable
# source for historical candles and backtests.
QFAE_MARKET_HISTORY_RETENTION_DAYS=2
QFAE_MARKET_HISTORY_DAYS=14
# Screen every live quote, but bound expensive minute features to the strongest
# candidates plus a rotating discovery batch.
QFAE_FULL_ANALYSIS_MAX_PER_MINUTE=300
QFAE_BACKGROUND_ANALYSIS_BATCH_SIZE=50
QFAE_DAILY_REGIME_REFRESH_MINUTES=15
# A feed started at the opening bell has no current-session gap to backfill.
QFAE_INTRADAY_BACKFILL_MIN_ELAPSED_MINUTES=2
# Persist full point-in-time JSON only for the strongest bounded candidate set.
QFAE_FULL_EVIDENCE_MAX_PER_MINUTE=50
# Background stocks retain compact checkpoints every 15 minutes or on state changes.
QFAE_COMPACT_EVIDENCE_INTERVAL_MINUTES=15
QFAE_COMPACT_EVIDENCE_SCORE_BUCKET=5
# Intraday Focus starts after 09:30 and uses confirmation to prevent list churn.
QFAE_FOCUS_START_MINUTES_AFTER_OPEN=15
QFAE_FOCUS_PROMOTE_CONFIRMATION_MINUTES=2
QFAE_FOCUS_COOLING_CONFIRMATION_MINUTES=2
QFAE_FOCUS_DEMOTE_CONFIRMATION_MINUTES=3
QFAE_FOCUS_MIN_SCORE=55
# Full-universe preparation is staged to keep the live path fast and memory-bounded.
QFAE_BOOTSTRAP_BATCH_SIZE=25
QFAE_BOOTSTRAP_ADMISSION_HISTORY_SESSIONS=25
QFAE_ENRICHMENT_FINANCIAL_LIMIT_PER_RUN=25
# Pause optional enrichment before the VM falls below this much available RAM.
QFAE_MEMORY_MIN_AVAILABLE_MB=1024
QFAE_ENRICHMENT_MEMORY_RETRY_MINUTES=15
# Provider-led NSE universe gate. Companies below Rs 500 crore are excluded.
QFAE_MIN_MARKET_CAP_CRORE=500
QFAE_MIN_SHARE_PRICE_INR=20
QFAE_MINUTE_HISTORY_RETENTION_DAYS=35
# PostgreSQL candles remain durable for backtesting unless pruning is explicitly enabled.
QFAE_PRUNE_PERSISTED_MINUTE_HISTORY=false
QFAE_MINUTE_PROFILE_MIN_SAMPLES=5
QFAE_CONFIRMATION_ACTIVE_RVOL=1.0
QFAE_CONFIRMATION_STRONG_RVOL=1.5
QFAE_CONFIRMATION_ACTIVE_ACCELERATION=1.0
QFAE_CONFIRMATION_STRONG_ACCELERATION=1.25
QFAE_RISK_REFERENCE_ORDER_VALUE_INR=100000
QFAE_RISK_MAX_SLIPPAGE_BPS=20
QFAE_RISK_MIN_CIRCUIT_DISTANCE_PERCENT=1
QFAE_RISK_MAX_GAP_ATR=2
QFAE_RISK_MAX_SPREAD_RANGE_BPS=10
# Optional. Keep unset until an explicit portfolio risk budget is chosen.
# QFAE_RISK_CAPITAL_INR=

QFAE_FINANCIAL_RESULTS_CACHE_DAYS=30
# Rolling liquidity tiers use completed daily traded value, not raw share volume.
QFAE_LIQUIDITY_LOOKBACK_SESSIONS=10
# A stock must trade in at least 8 of the latest 10 NIFTY sessions.
QFAE_LIQUIDITY_MIN_TRADED_SESSIONS=8
QFAE_LIQUIDITY_ACTIVE_MEDIAN_TRADED_VALUE_INR=20000000
# Provisional model-v3 weights. The service normalizes positive weights to 100.
QFAE_SCORE_WEIGHT_PRICE_TREND=30
QFAE_SCORE_WEIGHT_PARTICIPATION=20
QFAE_SCORE_WEIGHT_MARKET_SECTOR=20
# Execution quality is a hard eligibility gate, not an opportunity-score input.
QFAE_SCORE_WEIGHT_FUNDAMENTAL=15

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qfae
POSTGRES_USER=qfae
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# Optional complete SQLAlchemy URL. When set, it overrides the POSTGRES_* fields.
# QFAE_DATABASE_URL=postgresql+psycopg://qfae:password@localhost:5432/qfae
