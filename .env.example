# Upstox credentials — obtain these from your Upstox developer application.
# Never commit real values.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/auth/upstox/callback

# Local infrastructure
POSTGRES_DB=qfae
POSTGRES_USER=qfae
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
REDIS_PORT=6379

# Application
QFAE_ENVIRONMENT=development
QFAE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
